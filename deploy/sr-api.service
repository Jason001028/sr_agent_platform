# sr_agent_platform FastAPI 单元（场景浏览 + 队列页 + Agent + SR 本机执行）
# ------------------------------------------------------------------
# 用途：/api/scenes 检索与懒生成预览；/api/chat/* + /api/queue*（REST+SSE）
# + /api/tools + /api/masks。由 nginx 反代到 127.0.0.1:8000（SSE 缓冲已关，见 nginx.conf）。
# 路径白名单是双层保险的第二层 —— nginx 整块暴露场景根，后端再按 SR_SCENES_ROOT 校验。
#
# 本单元**同时是 SR 的执行者**：SR 作业由本进程 fork 出的子进程在**本机**直接跑
# （backend/services/local_exec.py），不经过任何调度器。所以下面「本机执行」那一段
# 的每一项都直接决定这台机器怎么跑 SR，缺一项提交就失败。
#
# 安装：
#   cp deploy/sr-api.service /etc/systemd/system/
#   ⚠️ 真机上**不要直接改部署后的这份正文**：真机差异用 drop-in 覆盖
#      （/etc/systemd/system/sr-api.service.d/*.conf，回滚=删文件；node81-135 上
#      有 20-agentdb.conf 一个）。同变量多处赋值时 drop-in 胜出。
#      drop-in 里写 SR_SLURM_* / SR_SANDBOX_ROOT / SR_SLURM_FAKE 一律无效 ——
#      平台不读这几个名字，留着只会让人以为配过了；发现即删。
#   按真机改：SR_SCENES_ROOT（必填）、SR_AGENT_DB 的目录归属、SR_WORK_DIR 的归属、
#   SR_PREVIEWS_ROOT 可选（配了必须在 SR_SCENES_ROOT 之下）；以及 SR_PYTHON /
#   SR_BUNDLE_DIR（SR 生产环境与本机路径）；WorkingDirectory / ExecStart 的 venv 路径。
#   systemctl daemon-reload && systemctl enable --now sr-api
#   查日志：journalctl -u sr-api -f
#
# 依赖（内网机一次性离线装好，见 requirements-api.txt）：fastapi uvicorn numpy pillow openai
#   例：<venv>/bin/pip install -r deploy/requirements-api.txt
#   注意这是 API 自己的 venv（python 3.9），与 SR 生产环境（SR_PYTHON）是两个平行
#   解释器：后端不 import SR/torch/GDAL，只在生成的运行脚本里写一行 SR_PYTHON 路径。

[Unit]
Description=sr_agent_platform FastAPI (scene browse + lazy preview JPG + local SR execution)
After=network.target

[Service]
Type=simple
# ⚠️ systemd 单元不支持「值后同行 # 注释」——会连注释一起当值读（User= 被读成脏名 → 217/USER）。
#    注释必须独占一行。曾因此导致真机 217/USER 排查半天（2026-09-07）。
User=nginx
# 跑 nginx 同用户；需能读 SR_SCENES_ROOT 并写预览 JPG 缓存。
# ⚠️ SR 作业也是这个用户跑的（子进程不换身份），所以「SR 能不能写场景目录」现在
#    等同「nginx 能不能写场景目录」——上线前用 `sudo -u nginx` 实测一次（见文件末尾）。
Group=nginx
# WorkingDirectory=               # 仓库根（backend 包需在 import 路径上），真机填，例：
WorkingDirectory=/data/www/sr-agent-platform
# ExecStart=<venv>/bin/uvicorn backend.api.app:create_app --factory --host 127.0.0.1 --port 8000
ExecStart=/opt/sr-venv/bin/uvicorn backend.api.app:create_app --factory --host 127.0.0.1 --port 8000
# ⚠️ 必须**单进程**：不要加 --workers N，也不要另起一个 uvicorn 指向同一个库。
#    每个 worker 都会各自起一份 lifespan 后台循环 —— 队列状态轮询、临时预览清理、
#    产物预览主动生成各做一遍（重复生成预览白烧磁盘），而执行槽位是**跨进程**文件锁
#    （<SR_WORK_DIR>/.exec.lock），第二个 worker 的作业只会一直排队拿不到槽。
Restart=on-failure
RestartSec=3
# 进程退出策略：SR 子进程与 API 同属本单元的 cgroup（子进程自建 session，但不脱离
# cgroup），所以 `systemctl stop sr-api` 会连正在跑的 SR 一起结束，不需要平台自己收尾。
# 这是有意的：作业**不能**脱离 API 独自留在机器上 —— 那种局面平台观察不到，只能
# 报「状态未知」。停止时先向整个 cgroup 发 SIGTERM，超时后 SIGKILL（control-group
# 就是 systemd 默认值，这里写出来是为了别被误改成 process）。
KillMode=control-group
TimeoutStopSec=30
# 同理：重启 API 会结束正在跑的作业。重启后平台读 <SR_WORK_DIR>/runs/<job_id>.json
# 与判定文件得出这次作业的终态，不会当成「没跑过」，也不会自动重跑。

# 场景根（nginx.conf 的 alias /data/scenes/ 须与此一致）
Environment=SR_SCENES_ROOT=/data/scenes
# SQLite 库路径（chat 会话消息 + sr_tasks 同库）。store 首次写自动建父目录，
# 但 User=nginx 须能写**父目录**（SQLite 建表/日志要往父目录落 journal 文件）。
# ⚠️ 别把库放在应用解压根里：解压根属 root、nginx 只读得动。2026-09-11 在 node81-135
#    实测 nginx **写不了** <APP>（探针 `write-db FAIL`）——库第一次被碰就
#    `unable to open database file`，于是 /api/queue 提交、chat 建会话全废，poller
#    还会每 2 秒炸一次。改法：库单独放一个 nginx 可写的专用目录（与 SR_WORK_DIR
#    同处大盘，不塞进代码树），示例为 node81-135 实测值：
#      mkdir -p /DiskArray/tmp/wangrz/sr_agent_db \
#        && chown nginx:nginx /DiskArray/tmp/wangrz/sr_agent_db && chmod 750 /DiskArray/tmp/wangrz/sr_agent_db
#    （SQLite 在 NFS 上只允许**单主机单进程**写——本平台只有 node81-135 跑 sr-api，
#      且本单元要求单进程，成立。）
Environment=SR_AGENT_DB=/DiskArray/tmp/wangrz/sr_agent_db/sr_agent.db
# 真机显式关假实现 —— mock LLM 必须 =0（离机验收 / .e2e 才置 =1）
Environment=SR_LLM_MOCK=0
# 可选：预览 JPG 缓存根（默认落源同目录）。配了必须在 SR_SCENES_ROOT 之下。
# Environment=SR_PREVIEWS_ROOT=/data/scenes/.previews
#
# 可选：**拖拽入口**的临时预览缓存根（2026-09-18）。用户把盘阵上的 .tif 拖进浏览器
# 时走这条：预览生成规则与上面那份长期缓存完全相同，但落在**独立**目录、按
# YYYY-MM-DD 分桶，每天 0 点整桶删除（服务启动时也先清一次）。
#   ⚠️ 生产**必须显式配**，别用默认值：默认是系统临时目录，而 CentOS7 的 /tmp
#      常常是 tmpfs（内存盘）—— 1/2 尺度不封顶，一张 2.4 万像素级的场景预览
#      可能上百 MB，写爆内存。放在大盘上。
#   ⚠️ 必须是 User=nginx 可写、且**不是** SR_SCENES_ROOT 之下的目录（临时缓存
#      不该混进生产数据目录）。清理只删「名字是 ISO 日期、且带本模块写的
#      .sr-tmp-preview 标记文件」的子目录，别的目录一个字节都不碰。
#   容量：只保留当天那一桶，等于一天的拖拽量；桶内不设上限。要缩就到磁盘配额去限。
#   Environment=SR_TEMP_PREVIEWS_ROOT=/DiskArray/tmp/wangrz/sr_tmp_previews
#
# 可选（2026-09-20）：**产物预览主动生成**——作业转 COMPLETED 后由后台循环同时把**产物那一份**
# 预览生成掉（只生成产物；输入影像与 _NOSR 两份仍按打开时惰性生成）。两个都有默认值，不配即生效。
#   SR_PRODUCT_PREVIEW_DIV 用哪一档（÷N），**0 = 关**（只留惰性路径），缺省 4。
#     取值不在 (2,4,8,16,32) 里 → 当 0 处理并在启动日志写一行，**不抛异常**。
#     ⚠️ 它与前端工具栏那条拖动条的默认值（同为 ÷4）是**两个独立的 4**，互不联动 ——
#        浏览器档位存在 localStorage，服务端看不见，所以主动生成必须有服务端自己的默认档。
#     ⚠️ 升级当天先置 0 起一次确认无异常再打开：两列是 ALTER TABLE 加的、**不回填**，
#        老行的 preview_state 全是 NULL（挡历史行的唯一屏障是下面那道年龄窗口）。
#   SR_PRODUCT_PREVIEW_MAX_AGE_SEC 只生成 finished_at 落在这个窗口内的行，缺省 86400；
#     finished_at IS NULL 的一律不生成。调大 = 升级那天会把更多历史行翻出来生成。
#   主动生成的结局随 GET /api/queue 的 preview_state / preview_note 两列带出（另有 SSE 帧
#   preview_update）。跳过时的 slug：product_missing / unwritable / source_changed / no_suffix，
#   外加正常结局 cached（场景目录里那份 JPG 已是当前档位，不重烤）。
#   产物落点就是任务行里的 lq_path 本身（作业在场景目录原地跑），没有第二处要判。
#   Environment=SR_PRODUCT_PREVIEW_DIV=4
#   Environment=SR_PRODUCT_PREVIEW_MAX_AGE_SEC=86400
# 可选：队列状态轮询秒（/api/queue/events 广播刷新率，缺省 2）
# Environment=SR_QUEUE_POLL_SEC=2
#
# ==========================================================================
# 本机执行 SR（这几项连同上面的 SR_AGENT_DB 一起决定「谁跑、跑什么、写哪」）
# ==========================================================================
# SR_PYTHON 是 **SR 生产环境**（conda env `torch1.9.1py36`，python 3.6 +
# torch + GDAL + ImgHistMatch.so），不是 API 自己的 /opt/sr-venv（python 3.9）。
# 2026-09-14 node81-135 实测：torch **1.10.2+cu113** / GDAL **2.4.0** ——
# 目录名里的 1.9.1 不是实际版本，别再照抄成「torch 1.9.1」。
# 核对方式（GDAL 用 VersionInfo()：老 osgeo 绑定没有 gdal.__version__）：
#   <该 python> -c "import torch; from osgeo import gdal; print(torch.__version__, gdal.VersionInfo())"
# 2026-09-10 用户确认：**沿用本行文档旧值，不用 base conda 的 python**
# （node81-135 登录 shell 默认在 (base) 环境，那与 SR 的生产解释器无关）。
# ⚠️ 现在这个解释器由 **nginx** 启动（以前是调度器在计算节点上起），所以 nginx 必须
#    对这条路径**可读可执行**（含 conda env 的 bin 与 lib）。生产机上它常在
#    /run/media/root/... 这类只给 root 的挂载点下，上线前实测一次（见文件末尾）。
Environment=SR_PYTHON=/run/media/root/SSD/program/anaconda/installed/envs/torch1.9.1py36/bin/python
#
# mmsr_bundle/codes：code_0817_prod.py / models / utils / options / tools 所在目录。
# 拼写以 code_0817_prod.py:27 的 load_library() 为准，两者必须完全一致。
# ⚠️ 同样要 nginx 可读；SR 的产物写不写这里取决于 SR 脚本自己，平台不写。
Environment=SR_BUNDLE_DIR=/DiskArray/ProductionSchedule/exe_CentOS7/SR_bundle/mmsr_bundle/codes
#
# 运行脚本要跑的三个程序名：都在 SR_BUNDLE_DIR 里，脚本 `cd` 进去后按名调用。
# ⚠️ 三个名字都是**提交时**由后端读 env 写死进运行脚本文本的，改完必须 restart
#    sr-api 才生效（已生成的脚本不受影响）。
# 变体与生产脚本**并置**即可，不必改名顶替 code_0817_prod.py ——
# 生产原文件因此保持字节不动，回滚 = 把 SR_SR_SCRIPT 改回 code_0817_prod.py。
# 不配这三项时默认就是 code_0817_prod.py / verify_sr_run.py / sr_prep_scene.py。
# ⚠️ verify_sr_run.py 与 sr_prep_scene.py 由本仓库提供（SR_code/variants/），
#    部署时要拷进 SR_BUNDLE_DIR；也可把这两项写成绝对路径，名字原样进脚本。
#    变体的来源与差异见 docs/sr_code/sr-platform-variant.md。
Environment=SR_SR_SCRIPT=code_0817_prod_platform.py
Environment=SR_VERIFY_SCRIPT=verify_sr_run.py
Environment=SR_PREP_SCRIPT=sr_prep_scene.py
#
# 运行期工作目录：每次提交在这里生成 config.xml 与运行脚本，
# 子进程的 stdout/stderr 落在 <work>/<脚本名>.out，作业记录在 <work>/runs/<job_id>.json。
# 默认值 /tmp/sr_agent_work —— 本机执行不需要共享盘，但**默认值在生产上要显式覆盖**：
# 一来 /tmp 常是 tmpfs（日志与 config 会吃掉内存），二来这个目录要长期留得住
# 「上次到底跑了什么」，重建机器后还得能回答。
# ⚠️ 归属与权限：nginx 需要**写**（建 config/脚本/日志/runs/.local_job_seq/.exec.lock）。
#    权限不足不会在启动时报错，而是在用户点提交时才暴露 —— 上线前实测一次（见文件末尾）。
Environment=SR_WORK_DIR=/DiskArray/tmp/wangrz/sr_agent_work
#   同一件事的另一个可读名字是 SR_SLURM_WORK_DIR（SR_WORK_DIR 优先）。两者都配时
#   以 SR_WORK_DIR 为准，别指望它们能各指一处。
#
# GPU 选择：本平台在这台机器上只用一张卡。值原样写进子进程的 CUDA_VISIBLE_DEVICES，
# 缺省 "0"。SR 脚本读它决定可见设备 —— 但**生产基线脚本自己会把它写回固定值**
# （main() 里赋 "0"、__main__ 里赋 "1"），所以本机执行用上面那个变体
# code_0817_prod_platform.py（它删掉那两行赋值）；换回基线时这张卡就由脚本说了算。
# ⚠️ 值里**不要**填「卡数」：这是可见设备列表（"0" / "0,1" / GPU UUID 皆可），
#    不是数量；填卡数只会让 SR 见到一张不存在的卡。
#   作业日志开头会把实际生效的 CUDA_VISIBLE_DEVICES 与可见卡的 index,uuid 打出来，
#   对不上时按日志排查。
# Environment=SR_LOCAL_GPU=0
#
# 本机执行**没有作业时限**：作业一直跑到自己结束，要停就在队列页取消（或停本单元）。
# SR_EXECUTOR 只接受 local（本机执行是唯一执行路线），不需要配。
#
# ==========================================================================
# 盘阵任意场景目录 —— 三项都**有默认值**，常见部署一项都不用配
# ==========================================================================
# 用途：让 SR_SCENES_ROOT（datahub）之外的合法场景目录也能在查看器打开、画掩码、
# 就地提交 SR。判据与库内场景相同（目录含 <目录名>_meta.xml，且含 <目录名>.tif
# 或 PAN.tif）。前端「盘阵场景」栏粘 Windows 形态路径，由 SR_DRIVE_MAP 译成服务端
# 形态；后端只 stat 用户给的那一个目录，不列举、不扫盘。
#
# 允许访问的盘阵前缀，`;` 分隔。**默认 /DiskArray**，即整个盘阵都放行；生产目录
# （/DiskArray/GSHC2IMPS/PRODUCT）本来就在这个默认值之下，所以不改也够用。若要收紧
# （例如只许生产树、不许 datahub），在这里列白名单：
#   Environment=SR_ALLOWED_ROOTS=/DiskArray/GSHC2IMPS/PRODUCT
#   ⚠️ 收紧后落在白名单外的路径提交会被 400 拒（含 datahub 场景），改前先确认没人依赖。
#   这是**词法**策略：不要求路径存在，所以开发机没有 /DiskArray 也能跑测试。
# Environment=SR_ALLOWED_ROOTS=/DiskArray
#
# 盘符映射，`;` 分隔的多条 `KEY=VAL`。默认 `W:=/DiskArray`（用户侧 W: 就是盘阵根）。
# 用户在资源管理器里看到的是 W:\GSHC2IMPS\PRODUCT\...，粘进来照这个表翻译。
#   ⚠️ 表里没有的盘符一律拒（400 报「未知盘符 X:」），不会静默当相对路径处理。
# Environment=SR_DRIVE_MAP=W:=/DiskArray
#
# 「文件名 → 场景目录」反推模板。占位符：
#   {y} {m} {d}  成像日（文件名里的 14 位或 8 位时间戳，取不到就报错让用户手粘）；
#                 渲染时按「成像日、次日」各来一遍，见下方说明
#   {name}       裸文件名（后缀已剥掉）= 景级场景目录名
#   {sat}        卫星型号（文件名第 1 段，如 JL1KF02B03）
#   {mid}        段级目录名 = 景级名去掉「景号」那一段
# 默认 W:\GSHC2IMPS\PRODUCT\{y}\{m}\{d}\{sat}\{mid}\{name} —— 即真机生产树的六层
#   <年>\<月>\<日>\<卫星型号>\<段级目录>\<景级目录>（2026-09-17 真机确认）。
# 配了就**只按这一条**走；**不配**则只按上面那条生产树模板。无论哪种，{d} 都**试两天**：
# 成像日与次日 —— 盘阵按生产日建目录，夜里成像的景记在第二天
# （名含 0917 的图大半在 0918 目录下，2026-09-18 修）。
# 名字不符合生产命名规则（拆不出 {sat}/{mid}）时跳过该候选，不硬拼空段。
# 反推命中才允许提交；一条都命中不了就报错并列出试过的候选与原因，绝不静默提交。
# ⚠️ 前端只把裸文件名发给后端，模板与命名规则**只有 pathguard.py 一处真源**。
# 命名规则与分段含义见 docs/sr_code/production-scene-naming.md。
# Environment=SR_SCENE_PATH_TEMPLATE=W:\GSHC2IMPS\PRODUCT\{y}\{m}\{d}\{sat}\{mid}\{name}
#
# ⚠️ 写权限是两级，且都要满足（现在都落在 nginx 这一个身份上）：
#   1) 运行期工作目录 <SR_WORK_DIR>：nginx 可写（config.xml / 脚本 / 日志 / runs/）。
#   2) 生产场景目录：nginx 可写 —— 画好的掩码 <输入影像名>_mask.tif 写回该目录，
#      SR 跑的产物 tif、Debug/ 日志、meta.xml 更新也落在同一目录；SR 在写产物前还会
#      把该路径上已存在的同名文件改名为 `*_NOSR.tif`，**源图本身不改名也不删除**。
#   上线前各测一次：
#     sudo -u nginx touch /DiskArray/tmp/wangrz/sr_agent_work/.wtest && echo WORK-OK
#     sudo -u nginx touch /DiskArray/GSHC2IMPS/PRODUCT/<年>/<月>/<日>/<生产编号>/.wtest \
#       && echo WRITE-OK && rm -f .../.wtest
#     sudo -u nginx <SR_PYTHON> -c "import torch, osgeo" && echo SRENV-OK
#     sudo -u nginx test -r <SR_BUNDLE_DIR>/code_0817_prod.py && echo BUNDLE-OK
#    只读的话会在写掩码/提交时才暴露，用户看到的是 403/500，而不是"这个目录不能写"。
#
# 备注：以上各项由 backend/config.sr_runtime() 与 run_sr.py 在**调用时**读 env，
# 改完 systemctl daemon-reload && systemctl restart sr-api 才生效——没有一项是进程
# 启动时快照，但运行脚本按**提交当时的值**生成，改前生成的作业不受影响。
# 可选：真 LLM 时配置（SR_LLM_MOCK=0 且未配这些则 loop 走默认 base/空 key）
# Environment=SR_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Environment=SR_LLM_API_KEY=
# Environment=SR_LLM_MODEL=qwen2.5-7b
# 可选：目录列表/磁盘行开关按需
# Environment=SR_API_HOST=127.0.0.1
